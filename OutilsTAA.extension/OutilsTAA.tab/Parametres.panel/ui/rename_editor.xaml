<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outils TAA — Renommage multiple" Width="1210" Height="690"
        MinWidth="990" MinHeight="570" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TAABackgroundBrush}" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="ÉTAPE 2 — RENOMMAGE MULTIPLE" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TAAOrangeBrush}"/>
      <TextBlock Name="ContextText" Foreground="{DynamicResource TAASecondaryTextBrush}"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="8"/><ColumnDefinition Width="320"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource TAAPanelBrush}" BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="1 — ÉLÉMENTS" FontWeight="Bold" Margin="0,0,0,8"/>
          <DataGrid Name="ObjectsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" RowHeight="20" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Inclure" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
              <DataGridTextColumn Header="Élément" Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource TAAPanelBrush}" BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel>
          <TextBlock Text="2 — OPÉRATION" FontWeight="Bold" Margin="0,0,0,10"/>
          <ComboBox Name="ModeCombo" Height="30" SelectionChanged="ModeChanged"/>
          <TextBlock Name="OperationLabel" Text="POSITION" Margin="0,12,0,4" FontWeight="Bold"/>
          <ComboBox Name="OperationCombo" Height="28" SelectionChanged="InputsChanged"/>
          <TextBlock Name="InputLabel" Text="TEXTE" Margin="0,12,0,4" FontWeight="Bold"/>
          <TextBox Name="InputText" Height="28" Padding="6,3" Background="White" Foreground="#252525" IsReadOnly="False"/>
          <TextBlock Name="ExtraLabel" Text="SÉPARATEUR" Margin="0,12,0,4" FontWeight="Bold"/>
          <TextBox Name="ExtraText" Height="28" Padding="6,3" Background="White" Foreground="#252525" IsReadOnly="False"/>
          <CheckBox Name="AddOnce" Margin="0,12,0,4" Content="Ne pas répéter un texte déjà présent" IsChecked="True"/>
          <TextBlock Text="Format : {valeur}, {index}, {famille}" TextWrapping="Wrap" Foreground="{DynamicResource TAASecondaryTextBrush}" Margin="0,12,0,0"/>
          <StackPanel Name="FormatFields" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="PARAMÈTRE À INSÉRER" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox Name="FormatParameterCombo" Height="28" DisplayMemberPath="FormatLabel"/>
            <Button Name="InsertParameterButton" Content="Insérer dans le format" Height="30" Margin="0,6,0,0"
                    Style="{DynamicResource TAASecondaryButton}" Click="InsertFormatParameter"/>
            <TextBlock Text="Valeurs texte ou numériques récupérées sur chaque élément." TextWrapping="Wrap"
                       Foreground="{DynamicResource TAASecondaryTextBrush}" Margin="0,5,0,0"/>
          </StackPanel>
          <Button Content="Actualiser l'aperçu" Style="{DynamicResource TAASecondaryButton}" Height="30" Margin="0,12,0,0" Click="RefreshPreview"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="{DynamicResource TAAPanelBrush}" BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="3 — APERÇU AVANT / APRÈS" FontWeight="Bold"/>
            <TextBlock Name="CountText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource TAASecondaryTextBrush}"/>
          </DockPanel>
          <DataGrid Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    RowHeaderWidth="0" RowHeight="20" ColumnHeaderHeight="26" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Élément" Binding="{Binding Label}" Width="*"/>
              <DataGridTextColumn Header="Avant" Binding="{Binding Before}" Width="*"/>
              <DataGridTextColumn Header="Après" Binding="{Binding After}" Width="*"/>
              <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="75"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Name="MessageText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
      <Button Content="Fermer" DockPanel.Dock="Right" Width="95" Height="34" Margin="8,0,0,0" Click="CloseWindow" Style="{DynamicResource TAASecondaryButton}"/>
      <Button Name="ApplyButton" Content="Appliquer les modifications" DockPanel.Dock="Right" Width="220" Height="34" Click="ApplyChanges" Style="{DynamicResource TAAPrimaryButton}"/>
      <CheckBox Name="ConfirmCheck" DockPanel.Dock="Right" Content="Je confirme les valeurs" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
  </Grid>
</Window>
