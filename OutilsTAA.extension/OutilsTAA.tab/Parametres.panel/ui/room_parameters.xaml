<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outils TAA — Paramètres des pièces" Width="1050" Height="680"
        MinWidth="850" MinHeight="550" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TAABackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="PARAMÈTRES DES PIÈCES" FontWeight="Bold" FontSize="21" Foreground="{DynamicResource TAATextBrush}"/>
      <TextBlock Text="Configuration à gauche, aperçu et contrôle à droite — sans fenêtre supplémentaire" Foreground="{DynamicResource TAASecondaryTextBrush}"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource TAAPanelBrush}" BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="OUTIL" FontWeight="Bold" Foreground="{DynamicResource TAAOrangeBrush}" Margin="0,0,0,8"/>
            <ComboBox Name="ModeCombo" Height="32" SelectionChanged="ModeChanged"/>
            <TextBlock Text="PARAMÈTRE DE DESTINATION" FontWeight="Bold" Margin="0,18,0,7"/>
            <ComboBox Name="ParameterCombo" Height="32" DisplayMemberPath="Label"/>
            <TextBlock Name="OperationLabel" Text="TYPE DE SÉQUENCE" FontWeight="Bold" Margin="0,18,0,7"/>
            <ComboBox Name="OperationCombo" Height="32"/>
            <TextBlock Name="InputLabel" Text="VALEUR DE DÉPART" FontWeight="Bold" Margin="0,18,0,7"/>
            <TextBox Name="InputText" Text="001" Padding="8" Height="32"/>
            <TextBlock Name="ExtraLabel" Text="PAS" FontWeight="Bold" Margin="0,18,0,7"/>
            <TextBox Name="ExtraText" Text="1" Padding="8" Height="32"/>
            <CheckBox Name="SharedValues" Content="Autoriser les valeurs partagées" Margin="0,18,0,8"/>
            <CheckBox Name="AddOnce" Content="Ne pas répéter un texte déjà présent" Margin="0,3,0,8" IsChecked="True"/>
            <TextBlock Text="PÉRIMÈTRE" FontWeight="Bold" Margin="0,18,0,7"/>
            <ComboBox Name="ScopeCombo" Height="32"/>
            <Button Name="SelectButton" Content="Sélectionner les pièces dans Revit" Style="{DynamicResource TAASecondaryButton}" Height="36" Margin="0,12,0,0" Click="SelectRooms"/>
            <Button Content="Actualiser l'aperçu" Style="{DynamicResource TAASecondaryButton}" Height="36" Margin="0,8,0,0" Click="RefreshPreview"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource TAAPanelBrush}" BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,11">
            <TextBlock Text="APERÇU DES MODIFICATIONS" FontWeight="Bold" Foreground="{DynamicResource TAATextBrush}"/>
            <TextBlock Name="CountText" Text="0 pièce" HorizontalAlignment="Right" Foreground="{DynamicResource TAASecondaryTextBrush}"/>
          </DockPanel>
          <DataGrid Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                    IsReadOnly="False" HeadersVisibility="Column" SelectionMode="Extended"
                    GridLinesVisibility="Horizontal" RowHeaderWidth="0">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Appliquer" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
              <DataGridTextColumn Header="Pièce" Binding="{Binding RoomLabel}" IsReadOnly="True" Width="*"/>
              <DataGridTextColumn Header="Avant" Binding="{Binding Before}" IsReadOnly="True" Width="*"/>
              <DataGridTextColumn Header="Après" Binding="{Binding After}" IsReadOnly="True" Width="*"/>
              <DataGridTextColumn Header="État" Binding="{Binding Status}" IsReadOnly="True" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource TAATextBrush}"/>
            <TextBlock Name="ReportText" TextWrapping="Wrap" Foreground="{DynamicResource TAASecondaryTextBrush}" Margin="0,5,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
      <TextBlock Name="FooterText" Text="Aucune modification avant validation." VerticalAlignment="Center" Foreground="{DynamicResource TAASecondaryTextBrush}"/>
      <Button Content="Fermer" Style="{DynamicResource TAASecondaryButton}" DockPanel.Dock="Right" Width="110" Height="36" Margin="10,0,0,0" Click="CloseWindow"/>
      <Button Name="ApplyButton" Content="Appliquer les modifications" Style="{DynamicResource TAAPrimaryButton}" DockPanel.Dock="Right" Width="220" Height="36" Click="ApplyChanges"/>
      <CheckBox Name="ConfirmCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,8,0" Content="Je confirme les valeurs"/>
    </DockPanel>
  </Grid>
</Window>
