<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Options avancées — Plans de vente"
    Width="650" Height="720" MinWidth="600" MinHeight="620"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TAABackgroundBrush}"
    FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Options avancées" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TAATextBrush}"/>
            <TextBlock Text="Réglages de génération des plans de vente"
                       Style="{DynamicResource TAASecondaryText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Création" Style="{DynamicResource TAASectionTitle}"/>
                        <CheckBox x:Name="OnlyWithoutExistingCheck"
                                  Content="Créer uniquement les logements sans plan existant"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Identification du logement" Style="{DynamicResource TAASectionTitle}"/>
                        <TextBlock Text="Paramètre texte utilisé pour regrouper les pièces"
                                   Margin="0,6,0,6" Style="{DynamicResource TAASecondaryText}"/>
                        <ComboBox x:Name="HousingParameterCombo" DisplayMemberPath="label"
                                  Style="{DynamicResource TAAComboBox}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cadrage et échelle" Style="{DynamicResource TAASectionTitle}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Marge de crop (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="CropMarginTextBox" Grid.Column="1"
                                     Style="{DynamicResource TAATextBox}"/>
                        </Grid>
                        <CheckBox x:Name="AutoScaleCheck"
                                  Content="Réduire l’échelle uniquement en cas de collision"
                                  Margin="0,12,0,0"/>
                        <TextBlock Text="Échelles de repli autorisées" Margin="0,10,0,4"/>
                        <TextBox x:Name="AllowedScalesTextBox"
                                 Style="{DynamicResource TAATextBox}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Rapport" Style="{DynamicResource TAASectionTitle}"/>
                        <CheckBox x:Name="DetailedReportCheck"
                                  Content="Afficher un rapport détaillé"
                                  Margin="0,10,0,6"/>
                        <CheckBox x:Name="LogWarningsCheck"
                                  Content="Journaliser les avertissements"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Déduit de la feuille modèle"
                                   Style="{DynamicResource TAASectionTitle}"/>
                        <TextBlock Text="Type d’étiquette, type de cote, gabarit du repérage, zone remplie, cartouche, positions et échelle de référence."
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Style="{DynamicResource TAASecondaryText}"/>
                        <TextBlock Text="Ces valeurs restent en lecture seule en 09A pour préserver le moteur 07D validé."
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Style="{DynamicResource TAASecondaryText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Annuler" Padding="18,7"
                    Style="{DynamicResource TAASecondaryButton}" Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="Appliquer" Padding="18,7"
                    Style="{DynamicResource TAAPrimaryButton}" Click="Apply_Click"/>
        </Grid>
    </Grid>
</Window>