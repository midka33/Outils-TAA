<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Plans de vente — Outils TAA"
    Width="1080"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource TAABackgroundBrush}"
    FontFamily="Segoe UI"
    FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="6"
                    Background="{DynamicResource TAAOrangeBrush}">
                <TextBlock Text="⌂" Foreground="White" FontSize="25"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Plans de vente" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TAATextBrush}"/>
                <TextBlock Text="Détection des logements · Prototype vue dépendante + crop"
                           Style="{DynamicResource TAASecondaryText}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource TAAPanelBrush}"
                    BorderBrush="{DynamicResource TAABorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Source" Style="{DynamicResource TAASectionTitle}"/>
                    <TextBlock Text="Paramètre identifiant le logement" Margin="0,4,0,6"
                               Foreground="{DynamicResource TAATextBrush}"/>
                    <ComboBox x:Name="HousingParameterCombo" DisplayMemberPath="label"
                              Style="{DynamicResource TAAComboBox}"/>
                    <TextBlock x:Name="RoomCountText" Margin="0,8,0,0"
                               Style="{DynamicResource TAASecondaryText}"/>
                    <TextBlock Margin="0,18,0,6" Text="Principe"
                               Style="{DynamicResource TAASectionTitle}"/>
                    <TextBlock Style="{DynamicResource TAASecondaryText}"
                               Text="Toutes les pièces partageant la même valeur sont regroupées dans un même logement. Les valeurs vides sont ignorées et signalées."/>
                    <Button x:Name="AnalyzeButton" Content="Analyser les logements"
                            Margin="0,18,0,0" HorizontalAlignment="Stretch"
                            Style="{DynamicResource TAAPrimaryButton}"
                            Click="Analyze_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Logements détectés"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock x:Name="HousingCountText" Grid.Column="1"
                                       Text="0 logement"
                                       Style="{DynamicResource TAASecondaryText}"/>
                        </Grid>

                        <DataGrid x:Name="HousingGrid" Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="HousingSelectionChanged"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="{DynamicResource TAABorderBrush}"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Logement" Binding="{Binding Key}" Width="2*"/>
                                <DataGridTextColumn Header="Pièces" Binding="{Binding RoomCount}" Width="*"/>
                                <DataGridTextColumn Header="Niveaux" Binding="{Binding Levels}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prototype — vue dépendante + crop"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock x:Name="PrototypeInfoText"
                                       Style="{DynamicResource TAASecondaryText}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Vue source"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="SourceViewCombo" Grid.Column="1"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SourceViewChanged"
                                          Style="{DynamicResource TAAComboBox}"/>

                                <TextBlock Grid.Column="3" Text="Marge crop (mm)"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="CropMarginTextBox" Grid.Column="4"
                                         Text="500"
                                         Style="{DynamicResource TAATextBox}"/>
                            </Grid>
                        </StackPanel>

                        <Button x:Name="CreatePrototypeButton" Grid.Column="2"
                                Content="Créer le prototype"
                                VerticalAlignment="Bottom"
                                Style="{DynamicResource TAAPrimaryButton}"
                                Click="CreatePrototype_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Style="{DynamicResource TAASecondaryText}"/>
            <Button Grid.Column="1" Content="Fermer"
                    Style="{DynamicResource TAASecondaryButton}"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
