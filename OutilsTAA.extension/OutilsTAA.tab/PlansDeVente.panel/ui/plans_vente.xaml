<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Plans de vente — Outils TAA"
    Width="1080"
    Height="920"
    MinWidth="900"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource TAABackgroundBrush}"
    FontFamily="Segoe UI"
    FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="6"
                    Background="{DynamicResource TAAOrangeBrush}">
                <TextBlock Text="⌂" Foreground="White" FontSize="25"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Plans de vente" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TAATextBrush}"/>
                <TextBlock Text="Étapes 07–08 · Génération et mise à jour"
                           Style="{DynamicResource TAASecondaryText}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource TAAPanelBrush}"
                    BorderBrush="{DynamicResource TAABorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <TextBlock Text="Source" Style="{DynamicResource TAASectionTitle}"/>
                    <TextBlock Text="Paramètre identifiant le logement" Margin="0,4,0,6"
                               Foreground="{DynamicResource TAATextBrush}"/>
                    <ComboBox x:Name="HousingParameterCombo" DisplayMemberPath="label"
                              Style="{DynamicResource TAAComboBox}"/>
                    <TextBlock x:Name="RoomCountText" Margin="0,8,0,0"
                               Style="{DynamicResource TAASecondaryText}"/>
                    <TextBlock Margin="0,18,0,6" Text="Principe"
                               Style="{DynamicResource TAASectionTitle}"/>
                    <TextBlock Style="{DynamicResource TAASecondaryText}"
                               Text="Toutes les pièces partageant la même valeur sont regroupées dans un même logement. Les valeurs vides sont ignorées et signalées."/>
                    <Button x:Name="AnalyzeButton" Content="Analyser les logements"
                            Margin="0,18,0,0" HorizontalAlignment="Stretch"
                            Style="{DynamicResource TAAPrimaryButton}"
                            Click="Analyze_Click"/>
                    <Separator Margin="0,22,0,18"/>
                    <TextBlock Text="Étape 04B — Plan de repérage"
                               Style="{DynamicResource TAASectionTitle}"/>
                    <TextBlock x:Name="LocationInfoText" Margin="0,0,0,10"
                               Style="{DynamicResource TAASecondaryText}"/>
                    <TextBlock Text="Vue source" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LocationSourceCombo" DisplayMemberPath="Label"
                              SelectionChanged="LocationChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>
                    <TextBlock Text="Gabarit" Margin="0,10,0,4"/>
                    <ComboBox x:Name="LocationTemplateCombo" DisplayMemberPath="Label"
                              SelectionChanged="LocationChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>
                    <TextBlock Text="Zone remplie" Margin="0,10,0,4"/>
                    <ComboBox x:Name="LocationFillTypeCombo" DisplayMemberPath="Label"
                              SelectionChanged="LocationChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>
                    <Button x:Name="CreateLocationPlanButton" Content="Créer le plan de repérage"
                            Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Style="{DynamicResource TAAPrimaryButton}"
                            Click="CreateLocationPlan_Click"/>
                    <Separator Margin="0,22,0,18"/>
                    <TextBlock Text="Étape 06F — Cotations"
                               Style="{DynamicResource TAASectionTitle}"/>
                    <TextBlock x:Name="DimensionInfoText" Margin="0,0,0,10"
                               Style="{DynamicResource TAASecondaryText}"/>
                    <TextBlock Text="Vue logement" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DimensionViewCombo" DisplayMemberPath="Label"
                              SelectionChanged="DimensionChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>
                    <TextBlock Text="Type de cote" Margin="0,10,0,4"/>
                    <ComboBox x:Name="DimensionTypeCombo"
                              SelectionChanged="DimensionChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>
                    <Button x:Name="CreateDimensionsButton" Content="Créer les cotations"
                            Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Style="{DynamicResource TAAPrimaryButton}"
                            Click="CreateDimensions_Click"/>
                    <Separator Margin="0,22,0,18"/>
                    <TextBlock Text="Étape 07C — Composition automatique"
                               Style="{DynamicResource TAASectionTitle}"/>
                    <TextBlock x:Name="SheetInfoText" Margin="0,0,0,10"
                               Style="{DynamicResource TAASecondaryText}"/>
                    <TextBlock Text="Feuille modèle — choix utilisateur" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SheetTemplateCombo"
                              SelectionChanged="SheetTemplateChanged"
                              DropDownOpened="SheetTemplateDropDownOpened"
                              Style="{DynamicResource TAAComboBox}"/>

                    <Border Margin="0,14,0,14"
                            Padding="10"
                            BorderBrush="{DynamicResource TAABorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Étape 07D — Génération complète"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock Text="Le modèle détermine automatiquement la vue logement, le repérage, les types d’annotations, toutes les nomenclatures placées, le cartouche, les positions et l’échelle de référence."
                                       Margin="0,4,0,8"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource TAASecondaryText}"/>
                            <Button x:Name="CreateFullPlanButton"
                                    Content="Créer le plan de vente complet"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="False"
                                    Style="{DynamicResource TAAPrimaryButton}"
                                    Click="CreateFullPlan_Click"/>

                            <Separator Margin="0,14,0,12"/>
                            <TextBlock Text="Étape 08 — Mise à jour"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock Text="Régénère les éléments PDV d’une feuille existante tout en conservant la feuille, le cartouche et les positions déjà ajustées."
                                       Margin="0,4,0,8"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource TAASecondaryText}"/>
                            <Button x:Name="UpdateFullPlanButton"
                                    Content="Mettre à jour le plan de vente"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="False"
                                    Style="{DynamicResource TAAPrimaryButton}"
                                    Click="UpdateFullPlan_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Réglages manuels 07C — diagnostic / secours"
                               Margin="0,2,0,0"
                               Style="{DynamicResource TAASecondaryText}"/>

                    <TextBlock Text="Vue modèle — logement" Margin="0,10,0,4"/>
                    <ComboBox x:Name="SheetMainViewCombo"
                              SelectionChanged="SheetRoleChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>

                    <TextBlock Text="Vue modèle — repérage" Margin="0,10,0,4"/>
                    <ComboBox x:Name="SheetLocationViewCombo"
                              SelectionChanged="SheetRoleChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>

                    <TextBlock Text="Nomenclature modèle — intérieure" Margin="0,10,0,4"/>
                    <ComboBox x:Name="SheetInteriorScheduleCombo"
                              SelectionChanged="SheetRoleChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>

                    <TextBlock Text="Nomenclature modèle — extérieure" Margin="0,10,0,4"/>
                    <ComboBox x:Name="SheetExteriorScheduleCombo"
                              SelectionChanged="SheetRoleChoiceChanged"
                              Style="{DynamicResource TAAComboBox}"/>

                    <Separator Margin="0,14,0,12"/>
                    <CheckBox x:Name="SheetAutoFitCheckBox"
                              Content="Réduire l’échelle uniquement en cas de collision"
                              IsChecked="True"
                              Click="SheetFitChoiceChanged"/>
                    <TextBlock Text="Échelles de repli autorisées" Margin="0,10,0,4"/>
                    <TextBox x:Name="SheetAllowedScalesTextBox"
                             Text="50, 75, 100, 125, 150"
                             TextChanged="SheetFitChoiceChanged"
                             Style="{DynamicResource TAATextBox}"/>
                    <TextBlock Text="Le 07C part toujours de l’échelle de la vue modèle. Il ne réduit le plan que s’il touche une autre vue, une nomenclature ou la géométrie du cartouche."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource TAASecondaryText}"/>

                    <Button x:Name="CreateSheetButton" Content="Créer la feuille"
                            Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Style="{DynamicResource TAAPrimaryButton}"
                            Click="CreateSheet_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Logements détectés"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock x:Name="HousingCountText" Grid.Column="1"
                                       Text="0 logement"
                                       Style="{DynamicResource TAASecondaryText}"/>
                        </Grid>

                        <DataGrid x:Name="HousingGrid" Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="HousingSelectionChanged"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="{DynamicResource TAABorderBrush}"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Logement" Binding="{Binding Key}" Width="2*"/>
                                <DataGridTextColumn Header="Pièces" Binding="{Binding RoomCount}" Width="*"/>
                                <DataGridTextColumn Header="Niveaux" Binding="{Binding Levels}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prototype — contour logement optimisé"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock x:Name="PrototypeInfoText"
                                       Style="{DynamicResource TAASecondaryText}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Vue source"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="SourceViewCombo" Grid.Column="1"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="SourceViewChanged"
                                          Style="{DynamicResource TAAComboBox}"/>

                                <TextBlock Grid.Column="3" Text="Échelle 1:"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="TargetScaleTextBox" Grid.Column="4"
                                         Text="50"
                                         Style="{DynamicResource TAATextBox}"/>

                                <TextBlock Grid.Column="6" Text="Marge crop (mm)"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="CropMarginTextBox" Grid.Column="7"
                                         Text="500"
                                         Style="{DynamicResource TAATextBox}"/>
                            </Grid>
                        </StackPanel>

                        <Button x:Name="CreatePrototypeButton" Grid.Column="2"
                                Content="Créer le contour optimisé"
                                VerticalAlignment="Bottom"
                                Style="{DynamicResource TAAPrimaryButton}"
                                Click="CreatePrototype_Click"/>
                    </Grid>
                </Border>
                <Border Grid.Row="4" Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Étape 04A — Nomenclatures"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock x:Name="ScheduleInfoText"
                                       Style="{DynamicResource TAASecondaryText}"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nomenclature intérieure" VerticalAlignment="Center"/>
                                <ComboBox x:Name="InteriorScheduleCombo" Grid.Row="0" Grid.Column="1"
                                          DisplayMemberPath="Label" SelectionChanged="ScheduleTemplateChanged"
                                          Style="{DynamicResource TAAComboBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Nomenclature extérieure" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ExteriorScheduleCombo" Grid.Row="2" Grid.Column="1"
                                          DisplayMemberPath="Label" SelectionChanged="ScheduleTemplateChanged"
                                          Style="{DynamicResource TAAComboBox}"/>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="CreateSchedulesButton" Grid.Column="2"
                                Content="Créer les nomenclatures" VerticalAlignment="Bottom"
                                Style="{DynamicResource TAAPrimaryButton}"
                                Click="CreateSchedules_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="6" Background="{DynamicResource TAAPanelBrush}"
                        BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Étape 05 — Étiquettes de pièces"
                                       Style="{DynamicResource TAASectionTitle}"/>
                            <TextBlock x:Name="RoomTagInfoText"
                                       Style="{DynamicResource TAASecondaryText}"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Vue logement"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="RoomTagViewCombo" Grid.Column="1"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="RoomTagChoiceChanged"
                                          Style="{DynamicResource TAAComboBox}"/>

                                <TextBlock Grid.Column="3" Text="Type étiquette"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="RoomTagTypeCombo" Grid.Column="4"
                                          SelectionChanged="RoomTagChoiceChanged"
                                          Style="{DynamicResource TAAComboBox}"/>
                            </Grid>
                        </StackPanel>

                        <Button x:Name="CreateRoomTagsButton" Grid.Column="2"
                                Content="Créer les étiquettes"
                                VerticalAlignment="Bottom"
                                Style="{DynamicResource TAAPrimaryButton}"
                                Click="CreateRoomTags_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Style="{DynamicResource TAASecondaryText}"/>
            <Button Grid.Column="1" Content="Fermer"
                    Style="{DynamicResource TAASecondaryButton}"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
