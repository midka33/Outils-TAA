<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Création des plans de vente"
        Width="740" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#FFFFFF"
        Foreground="#252525"
        Closing="Window_Closing">
    <StackPanel Margin="28,20,28,26">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Text="TAA" FontSize="22" FontWeight="Bold" Foreground="#FA641F"/>
            <TextBlock Text="Outils TAA · Plans de vente"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="HeadingText"
                   Text="Création des plans de vente"
                   FontSize="28"
                   FontWeight="SemiBold"/>

        <TextBlock x:Name="StatusText"
                   Text="Préparation de la génération…"
                   Foreground="#666666"
                   Margin="0,8,0,18"
                   Height="38"
                   TextWrapping="Wrap"/>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="22"
                             IsIndeterminate="False"
                             Foreground="#FD8B5A"
                             Background="#E3E6EA"
                             BorderThickness="0"/>
                <Grid Margin="0,7,0,0">
                    <TextBlock Text="0 %" Foreground="#666666"/>
                    <TextBlock Text="100 %"
                               HorizontalAlignment="Right"
                               Foreground="#666666"/>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="PercentText"
                       Grid.Column="1"
                       Text="0 %"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#FA641F"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Border Background="#F8F8F8" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Logement :" Foreground="#666666"/>
                    <TextBlock x:Name="HousingText"
                               Text="—"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,16"/>
                    <TextBlock Text="État :" Foreground="#666666"/>
                    <TextBlock x:Name="ItemText"
                               Text="Préparation"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1,0,0,0"
                        Padding="20,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Plans :" Foreground="#666666"/>
                        <TextBlock x:Name="UnitsText"
                                   Text="0 / 0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,16"/>
                        <TextBlock Text="Phase :" Foreground="#666666"/>
                        <TextBlock x:Name="PhaseText"
                                   Text="Préparation"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Columns="4" Margin="0,24,0,0">
            <Border x:Name="PrepareStep"
                    BorderBrush="#FD8B5A"
                    BorderThickness="0,3,0,0"
                    Margin="0,0,8,0"
                    Padding="0,10,0,0">
                <TextBlock Text="1 · Préparation" TextAlignment="Center"/>
            </Border>
            <Border x:Name="CreateStep"
                    BorderBrush="#FD8B5A"
                    BorderThickness="0,3,0,0"
                    Margin="0,0,8,0"
                    Padding="0,10,0,0"
                    Opacity="0.45">
                <TextBlock Text="2 · Création" TextAlignment="Center"/>
            </Border>
            <Border x:Name="AssembleStep"
                    BorderBrush="#FD8B5A"
                    BorderThickness="0,3,0,0"
                    Margin="0,0,8,0"
                    Padding="0,10,0,0"
                    Opacity="0.45">
                <TextBlock Text="3 · Assemblage" TextAlignment="Center"/>
            </Border>
            <Border x:Name="FinalizeStep"
                    BorderBrush="#FD8B5A"
                    BorderThickness="0,3,0,0"
                    Padding="0,10,0,0"
                    Opacity="0.45">
                <TextBlock Text="4 · Finalisation" TextAlignment="Center"/>
            </Border>
        </UniformGrid>

        <TextBlock Text="La progression peut rester fixe pendant la création d’un logement dans Revit."
                   Foreground="#666666"
                   FontSize="12"
                   Margin="0,20,0,0"
                   TextWrapping="Wrap"/>
    </StackPanel>
</Window>
