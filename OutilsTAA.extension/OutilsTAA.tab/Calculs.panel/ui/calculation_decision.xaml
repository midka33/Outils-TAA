<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculs des pièces — Décision"
        Width="680" Height="420" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F7F7F7" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadingText"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"
                   Foreground="#252525" TextWrapping="Wrap"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9D9D9"
                BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap"
                           Foreground="#252525"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" x:Name="OptionsPanel"
                BorderBrush="#D9D9D9" Background="White"
                BorderThickness="1" Padding="10" MaxHeight="180" MinHeight="100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CHOIX" FontSize="12"
                           FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="#666666"/>
                <ListBox Grid.Row="1" x:Name="ChoicesList"
                         BorderThickness="0" DisplayMemberPath="label"
                         SelectionChanged="Choice_Changed"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Annuler" Click="Cancel_Click"
                    MinWidth="100" Margin="0,0,8,0"
                    Style="{DynamicResource TAASecondaryButton}"/>
            <Button Grid.Column="2" x:Name="ConfirmButton"
                    Content="Continuer" Click="Confirm_Click" MinWidth="130"
                    Style="{DynamicResource TAAPrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
