<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculs des pièces — Vérification"
        Width="680" Height="490" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F7F7F7" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Vérifier le calcul"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="#252525" Margin="0,0,0,12"/>
        <Border Grid.Row="1" Background="White"
                BorderBrush="{DynamicResource TAABorderBrush}"
                BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="#252525"/>
                    <TextBlock x:Name="VariantsText" Margin="0,10,0,0"
                               TextWrapping="Wrap" Foreground="#333333"/>
                    <StackPanel x:Name="GroupSection" Margin="0,14,0,0">
                        <TextBlock Text="Valeurs des groupes"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="GroupModeCombo"
                                  DisplayMemberPath="label"
                                  SelectionChanged="GroupMode_Changed"
                                  Style="{DynamicResource TAAComboBox}"/>
                        <TextBlock x:Name="GroupHint" TextWrapping="Wrap"
                                   Foreground="#666666" Margin="0,6,0,0"/>
                        <StackPanel x:Name="UniformChoices" Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,0"
                               Foreground="#B42318" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Annuler" Click="Cancel_Click"
                    MinWidth="100" Margin="0,0,8,0"
                    Style="{DynamicResource TAASecondaryButton}"/>
            <Button Grid.Column="2" Content="Confirmer l'écriture"
                    Click="Confirm_Click" MinWidth="150"
                    Style="{DynamicResource TAAPrimaryButton}"/>
        </Grid>
    </Grid>
</Window>