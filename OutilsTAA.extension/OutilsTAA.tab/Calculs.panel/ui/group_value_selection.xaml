<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Calculs des pièces — Valeurs des groupes"
    Height="640"
    Width="900"
    MinHeight="480"
    MinWidth="760"
    WindowStartupLocation="CenterOwner"
    Background="#F7F7F7"
    FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Choisir les valeurs à conserver"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Pour conserver le paramètre aligné par type de groupe, choisissez la valeur à appliquer aux membres correspondants. La valeur la plus fréquente est présélectionnée, mais vous pouvez en choisir une autre."/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ConflictRowsPanel"/>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#FFF4EE"
                BorderBrush="{DynamicResource TAAOrangeBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="Attention : la valeur choisie sera appliquée à toutes les occurrences correspondantes afin que le paramètre puisse rester aligné par type de groupe."/>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Annuler"
                    Click="Cancel_Click"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Style="{DynamicResource TAASecondaryButton}"/>

            <Button Grid.Column="2"
                    Content="Appliquer les valeurs"
                    Click="Apply_Click"
                    MinWidth="160"
                    Style="{DynamicResource TAAPrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
