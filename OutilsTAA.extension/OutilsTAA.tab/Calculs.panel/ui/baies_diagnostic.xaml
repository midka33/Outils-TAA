<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Outils TAA — Diagnostic des baies" Width="1030" Height="690"
 MinWidth="780" MinHeight="480" WindowStartupLocation="CenterScreen"
 Background="#F7F7F7" FontFamily="Segoe UI">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Grid.Row="0" Text="Diagnostic des baies" FontSize="22"
   FontWeight="SemiBold" Margin="0,0,0,10"/>
  <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource TAABorderBrush}"
   BorderThickness="1" Padding="12" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="LECTURE SEULE" Style="{DynamicResource TAASectionTitle}"/>
    <TextBlock Text="Les cotes de familles ne démontrent pas la surface de la baie en tableau. Portes pleines comprises dans l'inventaire, non dans un calcul réglementaire."
     TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,8"/>
    <CheckBox x:Name="FacadeOnly" IsChecked="True" Margin="0,0,0,6"
     Content="Limiter aux familles commençant par FEN-EXT ou PORFEN-EXT"/>
    <CheckBox x:Name="ExcludeLanterns" IsChecked="True" Margin="0,0,0,6"
     Content="Exclure les lanterneaux du diagnostic et du périmètre candidat"/>
    <CheckBox x:Name="ExcludeMRX" IsChecked="True" Margin="0,0,0,6"
     Content="Exclure les MRX (murs-rideaux) du diagnostic et du périmètre candidat"/>
    <CheckBox x:Name="IncludeLinks" Margin="0,0,0,10"
     Content="Inclure les fichiers Revit liés directs chargés"/>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="AnalyzeButton" Content="Analyser" Width="140"
      Click="Analyze_Click" Style="{DynamicResource TAAPrimaryButton}"/>
     <Button x:Name="ExportButton" Content="Exporter les CSV" Width="170"
      Margin="10,0,0,0" IsEnabled="False" Click="Export_Click"
      Style="{DynamicResource TAASecondaryButton}"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,0,0,9"
   Text="Prêt à analyser le projet." TextWrapping="Wrap"/>
  <DataGrid Grid.Row="3" x:Name="TypesGrid" AutoGenerateColumns="False"
   IsReadOnly="True" CanUserAddRows="False" Background="White"
   AlternatingRowBackground="#F7F7F7" BorderBrush="#D9D9D9">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Source" Binding="{Binding source}" Width="160"/>
    <DataGridTextColumn Header="Famille" Binding="{Binding family}" Width="*"/>
    <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="*"/>
    <DataGridTextColumn Header="Nb" Binding="{Binding count}" Width="55"/>
    <DataGridTextColumn Header="Méthode" Binding="{Binding methods}" Width="145"/>
    <DataGridTextColumn Header="Dimensions" Binding="{Binding status}" Width="195"/>
    <DataGridTextColumn Header="Façade" Binding="{Binding facade_status}" Width="220"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#666666"
   Text="4 CSV : occurrences, types, alertes, exclusions tracées. Aucune surface n’est certifiée pour la RE2020."/>
 </Grid>
</Window>
