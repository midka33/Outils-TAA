<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Calculs des pièces"
    Height="760"
    Width="760"
    MinHeight="680"
    MinWidth="680"
    WindowStartupLocation="CenterScreen"
    Background="#F7F7F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Calculs des pièces" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Regrouper des pièces, additionner une valeur et écrire le résultat dans un paramètre."
                       Margin="0,5,0,0" Style="{DynamicResource TAASecondaryText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SOURCE" Style="{DynamicResource TAASectionTitle}"/>
                        <TextBlock x:Name="SourceScopeText"
                                   Text="Toutes les pièces du projet"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SourceCountText"
                                   Margin="0,4,0,0"
                                   Style="{DynamicResource TAASecondaryText}"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="FILTRE (OPTIONNEL)"
                                   Style="{DynamicResource TAASectionTitle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Paramètre"
                                   VerticalAlignment="Center" Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  x:Name="FilterParameterCombo"
                                  DisplayMemberPath="label"
                                  SelectionChanged="FilterParameterChanged"
                                  Margin="0,0,0,8"
                                  Style="{DynamicResource TAAComboBox}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Valeur exacte"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 x:Name="FilterValueTextBox"
                                 IsEnabled="False"
                                 Style="{DynamicResource TAATextBox}"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="CALCUL"
                                   Style="{DynamicResource TAASectionTitle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Regrouper par"
                                   VerticalAlignment="Center" Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  x:Name="GroupParameterCombo"
                                  DisplayMemberPath="label"
                                  Margin="0,0,0,8"
                                  Style="{DynamicResource TAAComboBox}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Additionner"
                                   VerticalAlignment="Center" Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  x:Name="SourceParameterCombo"
                                  DisplayMemberPath="label"
                                  SelectionChanged="SourceParameterChanged"
                                  Margin="0,0,0,8"
                                  Style="{DynamicResource TAAComboBox}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Paramètre destination"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  x:Name="TargetParameterCombo"
                                  DisplayMemberPath="label"
                                  Style="{DynamicResource TAAComboBox}"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="UNITÉ DE SORTIE"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource TAASectionTitle}"/>
                        <ComboBox Grid.Column="1" x:Name="UnitCombo"
                                  DisplayMemberPath="label"
                                  Style="{DynamicResource TAAComboBox}"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="{DynamicResource TAABorderBrush}"
                        BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ÉTAT" Style="{DynamicResource TAASectionTitle}"/>
                        <TextBlock x:Name="StatusText" Text="Prêt."
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="ProgressBar"
                                     Minimum="0" Maximum="100"
                                     Height="8" Margin="0,10,0,0"
                                     Value="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Les résultats sont validés avant l'ouverture de la transaction Revit."
                       VerticalAlignment="Center"
                       Style="{DynamicResource TAASecondaryText}"/>
            <Button Grid.Column="1" Content="Fermer" Click="Close_Click"
                    MinWidth="100" Margin="12,0,8,0"
                    Style="{DynamicResource TAASecondaryButton}"/>
            <Button Grid.Column="2" x:Name="CalculateButton"
                    Content="Calculer" Click="Calculate_Click"
                    MinWidth="130"
                    Style="{DynamicResource TAAPrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
