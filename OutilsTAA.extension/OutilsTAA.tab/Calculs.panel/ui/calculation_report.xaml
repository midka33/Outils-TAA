<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Calculs des pièces — Rapport"
    Height="520"
    Width="720"
    MinHeight="420"
    MinWidth="600"
    WindowStartupLocation="CenterOwner"
    Background="#F7F7F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Rapport du calcul" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Margin="0,5,0,0"
                       Style="{DynamicResource TAASecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White"
                BorderBrush="{DynamicResource TAABorderBrush}"
                BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <TextBlock x:Name="CountsText" TextWrapping="Wrap"/>
        </Border>

        <TextBox Grid.Row="2" x:Name="DetailsText"
                 IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 Style="{DynamicResource TAATextBox}"/>

        <Button Grid.Row="3" Content="Fermer" Click="Close_Click"
                HorizontalAlignment="Right" MinWidth="100" Margin="0,14,0,0"
                Style="{DynamicResource TAASecondaryButton}"/>
    </Grid>
</Window>
