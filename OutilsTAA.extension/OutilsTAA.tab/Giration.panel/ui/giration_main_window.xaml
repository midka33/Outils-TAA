<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OutilsTAA.extension.OutilsTAA.tab.Giration.panel.ui"
        mc:Ignorable="d"
        Title="Giration des véhicules - Outils TAA" 
        Height="600" Width="900" 
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource TaaBackground}" Foreground="{DynamicResource TaaText}" 
        UseLayoutRounding="True">
    
    <Window.Resources>
        <!-- Styles pour s'intégrer à la charte Outils TAA -->
        <Style TargetType="Button" x:Key="TaaButton">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource TaaBrand}"/>
            <Setter Property="Foreground" Value="{DynamicResource TaaSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TaaBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="ComboBox" x:Key="TaaComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="{DynamicResource TaaSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TaaText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TaaBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style TargetType="TextBox" x:Key="TaaTextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="{DynamicResource TaaSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TaaText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TaaBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style TargetType="Label" x:Key="TaaLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TaaText}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        
        <Style TargetType="CheckBox" x:Key="TaaCheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TaaText}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style TargetType="GroupBox" x:Key="TaaGroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TaaBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource TaaSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TaaText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border Width="40" Height="40" CornerRadius="4" 
                    Background="{DynamicResource TaaBrand}" Margin="0,0,12,0" DockPanel.Dock="Left">
                <TextBlock Text="TAA" Foreground="{DynamicResource TaaSurface}" 
                           FontSize="15" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Giration des véhicules" FontSize="20" FontWeight="SemiBold" Margin="0"/>
                <TextBlock Text="Simulation de trajectoires et enveloppes balayées" 
                           Foreground="{DynamicResource TaaSecondary}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        
        <!-- Contenu principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200"/>
                <ColumnDefinition Width="1*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Panneau de sélection des véhicules -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource TaaBorder}" BorderThickness="1" 
                    Padding="12" Margin="0,0,8,0" Style="{DynamicResource TaaCard}">
                <StackPanel>
                    <TextBlock Text="Sélection du véhicule" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    
                    <!-- Catégories -->
                    <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" 
                              SelectionChanged="CategoryCombo_SelectionChanged"
                              Style="{StaticResource TaaComboBox}" Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Véhicules -->
                    <ComboBox x:Name="VehicleCombo" DisplayMemberPath="name" 
                              SelectionChanged="VehicleCombo_SelectionChanged"
                              Style="{StaticResource TaaComboBox}" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding name}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding category}" FontSize="11" 
                                               Foreground="{DynamicResource TaaSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Caractéristiques du véhicule -->
                    <GroupBox Header="Caractéristiques" Style="{StaticResource TaaGroupBox}" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Longueur:" Width="100" Style="{StaticResource TaaLabel}"/>
                                <TextBlock x:Name="LengthValue" Text="0.0 m" FontSize="13" 
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Largeur:" Width="100" Style="{StaticResource TaaLabel}"/>
                                <TextBlock x:Name="WidthValue" Text="0.0 m" FontSize="13"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Empattement:" Width="100" Style="{StaticResource TaaLabel}"/>
                                <TextBlock x:Name="WheelbaseValue" Text="0.0 m" FontSize="13"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rayon min:" Width="100" Style="{StaticResource TaaLabel}"/>
                                <TextBlock x:Name="MinRadiusValue" Text="0.0 m" FontSize="13"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Braquage max:" Width="100" Style="{StaticResource TaaLabel}"/>
                                <TextBlock x:Name="MaxSteeringValue" Text="0°" FontSize="13"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Options d'affichage -->
                    <GroupBox Header="Options d'affichage" Style="{StaticResource TaaGroupBox}">
                        <StackPanel>
                            <CheckBox x:Name="ShowVehicleCheckbox" Content="Afficher le véhicule" 
                                      IsChecked="True" Style="{StaticResource TaaCheckBox}"/>
                            <CheckBox x:Name="ShowWheelTrajectoriesCheckbox" Content="Trajectoires des roues" 
                                      IsChecked="True" Style="{StaticResource TaaCheckBox}"/>
                            <CheckBox x:Name="ShowSweptAreaCheckbox" Content="Enveloppe balayée" 
                                      IsChecked="True" Style="{StaticResource TaaCheckBox}"/>
                            <CheckBox x:Name="ShowPositionsCheckbox" Content="Positions intermédiaires" 
                                      IsChecked="True" Style="{StaticResource TaaCheckBox}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>
            
            <!-- Zone de visualisation et commandes -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource TaaBorder}" BorderThickness="1" 
                    Padding="12" Margin="8,0,0,0" Style="{DynamicResource TaaCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Barre d'outils -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="StartButton" Content="Démarrer le tracé" 
                                Click="StartButton_Click" Style="{StaticResource TaaButton}"
                                ToolTip="Commencer à tracer la trajectoire"/>
                        <Button x:Name="CancelButton" Content="Annuler" 
                                Click="CancelButton_Click" Style="{StaticResource TaaButton}"
                                IsEnabled="False" ToolTip="Annuler le tracé en cours"/>
                        <Button x:Name="UndoButton" Content="Annuler dernier" 
                                Click="UndoButton_Click" Style="{StaticResource TaaButton}"
                                IsEnabled="False" ToolTip="Annuler le dernier segment"/>
                        <Button x:Name="ClearButton" Content="Effacer tout" 
                                Click="ClearButton_Click" Style="{StaticResource TaaButton}"
                                ToolTip="Effacer la trajectoire actuelle"/>
                        <Button x:Name="FinishButton" Content="Terminer" 
                                Click="FinishButton_Click" Style="{StaticResource TaaButton}"
                                IsEnabled="False" ToolTip="Terminer et enregistrer la simulation"/>
                    </StackPanel>
                    
                    <!-- Zone de dessin (à implémenter avec Revit API) -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource TaaBorder}" 
                            BorderThickness="1" Background="{DynamicResource TaaSurface}" 
                            CornerRadius="4" Padding="8">
                        <Grid>
                            <TextBlock Text="Zone de visualisation Revit" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TaaSecondary}" FontSize="14"/>
                            <TextBlock Text="Le tracé s'affichera directement dans la vue de plan Revit active." 
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TaaSecondary}" FontSize="12" Margin="0,0,0,8"/>
                        </Grid>
                    </Border>
                    
                    <!-- Infos et statut -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="StatusText" Text="Prêt" 
                                   Foreground="{DynamicResource TaaText}" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TrajectoryInfo" Text="Aucune trajectoire" 
                                   Foreground="{DynamicResource TaaSecondary}" FontSize="13"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Pied de page -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="HelpButton" Content="Aide" 
                    Click="HelpButton_Click" Style="{StaticResource TaaButton}"
                    MinWidth="80"/>
            <Button x:Name="CloseButton" Content="Fermer" 
                    Click="CloseButton_Click" Style="{StaticResource TaaButton}"
                    MinWidth="80" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
