<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giration — prototype Outils TAA" Height="420" Width="610"
        MinHeight="400" MinWidth="560" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Giration des véhicules" FontSize="21"
                   FontWeight="SemiBold" Margin="0,0,0,15"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Véhicule (gabarits provisoires non vérifiés)"/>
            <ComboBox x:Name="VehicleCombo" MinHeight="32" Margin="0,5,0,12"/>
            <TextBlock x:Name="VehicleInfo" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <CheckBox x:Name="ReverseCheck" Content="Manœuvre en marche arrière" Margin="0,4,0,8"/>
            <CheckBox x:Name="AcknowledgeCheck">
                <TextBlock TextWrapping="Wrap" MaxWidth="510"
                           Text="Je comprends que ces gabarits ne sont pas homologués et que les courbes tracées ne sont pas une preuve de conformité."/>
            </CheckBox>
        </StackPanel>
        <Border Grid.Row="3" CornerRadius="4" Padding="12" Margin="0,18,0,10"
                Background="{DynamicResource TaaMuted}">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                Text="Prototype par clics : après validation, cliquez l'arrière du véhicule, son orientation, puis les positions successives de l'essieu arrière. Échap termine. Aucun aperçu dynamique n'est encore disponible."/>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Fermer" MinWidth="90" Margin="0,0,12,0"/>
            <Button x:Name="StartButton" Content="Tracer (prototype)" MinWidth="155"
                    Background="{DynamicResource TaaAccent}"/>
        </StackPanel>
    </Grid>
</Window>
