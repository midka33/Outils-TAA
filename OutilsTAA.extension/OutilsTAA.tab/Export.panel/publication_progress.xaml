<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export PDF en cours" Width="740" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="#FFFFFF" Foreground="#252525"
        Closing="Window_Closing">
    <StackPanel Margin="28,20,28,26">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Text="TAA" FontSize="22" FontWeight="Bold" Foreground="#FA641F"/>
            <TextBlock Text="Outils TAA · Export" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="HeadingText" Text="Export PDF en cours" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="StatusText" Text="Préparation de la publication…" Foreground="#666666"
                   Margin="0,8,0,24" TextWrapping="Wrap"/>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="22"
                             IsIndeterminate="False" Foreground="#FD8B5A" Background="#E3E6EA"
                             BorderThickness="0" AutomationProperties.Name="Progression globale de publication"/>
                <Grid Margin="0,7,0,0">
                    <TextBlock Text="0 %" Foreground="#666666"/>
                    <TextBlock Text="100 %" HorizontalAlignment="Right" Foreground="#666666"/>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="PercentText" Grid.Column="1" Text="0 %" FontSize="36"
                       FontWeight="Bold" Foreground="#FA641F" HorizontalAlignment="Right"/>
        </Grid>
        <Border Background="#F8F8F8" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Carnet :" Foreground="#666666"/>
                    <TextBlock x:Name="CarnetText" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,16"/>
                    <TextBlock Text="Élément en cours :" Foreground="#666666"/>
                    <TextBlock x:Name="ItemText" Text="Préparation" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#D9D9D9" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Traitement :" Foreground="#666666"/>
                        <TextBlock x:Name="UnitsText" Text="0 / 0 unités" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,16"/>
                        <TextBlock Text="Étape :" Foreground="#666666"/>
                        <TextBlock x:Name="PhaseText" Text="Préparation" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <UniformGrid Columns="4" Margin="0,24,0,0">
            <Border x:Name="PrepareStep" BorderBrush="#FD8B5A" BorderThickness="0,3,0,0" Margin="0,0,8,0" Padding="0,10,0,0">
                <TextBlock Text="1 · Préparation" TextAlignment="Center"/>
            </Border>
            <Border x:Name="ExportStep" BorderBrush="#FD8B5A" BorderThickness="0,3,0,0" Margin="0,0,8,0" Padding="0,10,0,0" Opacity="0.45">
                <TextBlock Text="2 · Export" TextAlignment="Center"/>
            </Border>
            <Border x:Name="DeliveryStep" BorderBrush="#FD8B5A" BorderThickness="0,3,0,0" Margin="0,0,8,0" Padding="0,10,0,0" Opacity="0.45">
                <TextBlock Text="3 · Livraison" TextAlignment="Center"/>
            </Border>
            <Border x:Name="FinalizeStep" BorderBrush="#FD8B5A" BorderThickness="0,3,0,0" Padding="0,10,0,0" Opacity="0.45">
                <TextBlock Text="4 · Finalisation" TextAlignment="Center"/>
            </Border>
        </UniformGrid>
        <TextBlock Text="La progression peut rester fixe pendant l’export Revit."
                   Foreground="#666666" FontSize="12" Margin="0,20,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
