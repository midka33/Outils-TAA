<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aperçu de publication — Outils TAA" Width="1150" Height="700" MinWidth="900" MinHeight="520" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource TaaBackground}" Foreground="{DynamicResource TaaText}" UseLayoutRounding="True">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource TaaBrand}" Margin="0,0,12,0" DockPanel.Dock="Left">
        <TextBlock Text="TAA" Foreground="{DynamicResource TaaSurface}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Aperçu de publication" FontSize="20" FontWeight="SemiBold" Margin="0" />
        <TextBlock Text="Vérifier les fichiers et les destinations avant de publier" Foreground="{DynamicResource TaaSecondary}" FontSize="12" Margin="0,3,0,0" />
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock x:Name="SummaryText" FontSize="14" />
      <TextBlock x:Name="DestinationText" FontSize="12" Opacity="0.75" Margin="0,3,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,10">
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource TaaError}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="WarningText" Foreground="{DynamicResource TaaWarning}" Margin="0,5,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <DataGrid Grid.Row="3" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,0,0,12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Carnet" Binding="{Binding Carnet}" Width="150" />
        <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="75" />
        <DataGridTextColumn Header="Mise en page" Binding="{Binding Name}" Width="2*" />
        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70" />
        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="85" />
        <DataGridTextColumn Header="Nom final" Binding="{Binding Filename}" Width="1.6*" />
        <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="2.5*" />
        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="100" />
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Aucun export Revit n'est lancé avant votre confirmation." VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Ouvrir le dossier" Click="OpenFolder_Click" Padding="14,7" Margin="8,0" ToolTip="Ouvrir le dossier" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="CancelButton" Content="Annuler" Click="Cancel_Click" Padding="18,7" Margin="8,0,0,0" IsCancel="True" ToolTip="Annuler" />
        <Button x:Name="ConfirmButton" Content="Confirmer et publier" Click="Confirm_Click" Padding="18,7" Margin="8,0,0,0" IsDefault="True" Style="{DynamicResource TaaPrimaryButton}" ToolTip="Confirmer et publier" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
