<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rapport de publication — Outils TAA" Width="980" Height="620" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource TaaBackground}" Foreground="{DynamicResource TaaText}" UseLayoutRounding="True" MinWidth="880" MinHeight="560">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource TaaBrand}" Margin="0,0,12,0" DockPanel.Dock="Left">
        <TextBlock Text="TAA" Foreground="{DynamicResource TaaSurface}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Rapport de publication" FontSize="20" FontWeight="SemiBold" Margin="0" />
        <TextBlock Text="Consulter les fichiers produits et les éventuels diagnostics" Foreground="{DynamicResource TaaSecondary}" FontSize="12" Margin="0,3,0,0" />
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <TextBlock x:Name="SummaryText" FontSize="14" />
      <TextBlock x:Name="DestinationText" FontSize="12" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <DataGrid Grid.Row="2" x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,14">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Carnet" Binding="{Binding Carnet}" Width="1.3*" />
        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="75" />
        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90" />
        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="105" />
        <DataGridTextColumn Header="Feuilles" Binding="{Binding Count}" Width="70" />
        <DataGridTextColumn Header="Fichier / répertoire" Binding="{Binding Path}" Width="2*" />
        <DataGridTextColumn Header="Détails" Binding="{Binding Details}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="WarningsText" Grid.Column="0" VerticalAlignment="Center" IsReadOnly="True" AcceptsReturn="True" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" Margin="0,0,12,0" />
      <Button Grid.Column="1" Content="Ouvrir le dossier" Padding="14,7" Margin="0,0,8,0" Click="OpenFolder_Click" ToolTip="Ouvrir le dossier" />
      <Button Grid.Column="2" Content="Fermer" Padding="18,7" IsDefault="True" Click="Close_Click" ToolTip="Fermer" />
    </Grid>
  </Grid>
</Window>
