<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="À propos — Outils TAA" Width="480" Height="300" MinWidth="450" MinHeight="270" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource TaaBackground}" Foreground="{DynamicResource TaaText}" UseLayoutRounding="True">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <Border Width="44" Height="44" CornerRadius="4" Background="{DynamicResource TaaBrand}" Margin="0,0,12,0">
        <TextBlock Text="TAA" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TaaSurface}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Outils TAA" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Suite d'outils pour Autodesk Revit" FontSize="12" Foreground="{DynamicResource TaaSecondary}" Margin="0,3,0,0"/>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource TaaSurface}" BorderBrush="{DynamicResource TaaBorder}" BorderThickness="1" CornerRadius="4" Padding="14">
      <StackPanel>
        <TextBlock x:Name="AboutVersionText" Text="Version indisponible" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="AboutReleaseText" Text="" Foreground="{DynamicResource TaaSecondary}" Margin="0,0,0,8"/>
        <TextBlock x:Name="AboutStatusText" Text="" TextWrapping="Wrap" Foreground="{DynamicResource TaaSecondary}" Margin="0,0,0,8"/>
        <TextBlock Text="Compatibilité cible : Revit 2025.4 · pyRevit 5.x" FontSize="12" Foreground="{DynamicResource TaaSecondary}"/>
      </StackPanel>
    </Border>
    <Button Grid.Row="2" Content="Fermer" Click="Close_Click" MinWidth="100" MinHeight="30" HorizontalAlignment="Right" Margin="0,14,0,0" IsDefault="True" IsCancel="True" ToolTip="Fermer la fenêtre À propos"/>
  </Grid>
</Window>
