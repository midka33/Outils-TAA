<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Height="760" Width="1120"
        MinHeight="660" MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Export" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
        <GroupBox Grid.Row="1" Header="Mode de création" Padding="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeParameter" Content="Paramètre" IsChecked="True" GroupName="Mode" Checked="Mode_Checked" Margin="8,4,28,4"/>
                <RadioButton x:Name="ModeManual" Content="Manuel" GroupName="Mode" Checked="Mode_Checked" Margin="8,4,28,4"/>
                <RadioButton x:Name="ModeTemporary" Content="Temporaire" GroupName="Mode" Checked="Mode_Checked" Margin="8,4,28,4"/>
            </StackPanel>
        </GroupBox>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Paramètre de regroupement" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox Grid.Row="1" x:Name="ParameterCombo" Height="32" Margin="0,0,0,10" SelectionChanged="ParameterCombo_SelectionChanged"/>
                    <TextBlock Grid.Row="2" x:Name="ParameterInfo" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="3" x:Name="ManualPanel" Visibility="Collapsed">
                        <TextBlock Text="Nom du carnet" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="CarnetNameTextBox" Height="30" Margin="0,0,0,8"/>
                        <Button x:Name="SelectSheetsButton" Content="Sélectionner les feuilles dans Revit" Click="SelectSheets_Click"/>
                        <TextBlock x:Name="ManualSelectionInfo" Text="Aucune sélection." TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <CheckBox x:Name="PersistentCheckBox" Content="Enregistrer ce carnet pour les prochaines sessions" IsChecked="True" Margin="4,4,4,4"/>
                    </StackPanel>
                    <GroupBox Grid.Row="4" Header="Carnets disponibles à la sélection" Padding="6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Cochez les carnets à publier." TextWrapping="Wrap" Margin="2,0,2,6"/>
                            <DataGrid Grid.Row="1" x:Name="PersistentCarnetsList"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      SelectionMode="Single"
                                      MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Publier" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Checked="CarnetCheckChanged"
                                                          Unchecked="CarnetCheckChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Carnet" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Feuilles" Binding="{Binding Count}" Width="65"/>
                                    <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                    <StackPanel Grid.Row="5">
                        <TextBlock x:Name="CarnetsSelectionInfo" Text="En mode Paramètre, sélectionnez les carnets à publier." TextWrapping="Wrap" Margin="4,6,4,2"/>
                        <Button x:Name="DeleteCarnetButton" Content="Supprimer le carnet sélectionné" Click="DeleteCarnet_Click"/>
                        <GroupBox Header="Publication" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Dossier de destination" FontWeight="Bold" Margin="0,0,0,5"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseOutput_Click" Width="90"/>
                                    <TextBox x:Name="OutputDirectoryTextBox" Height="30" Margin="0,0,6,0"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="PdfCheckBox" Content="PDF" IsChecked="True" Margin="4,4,18,4"/>
                                    <RadioButton x:Name="PdfCombinedRadio" Content="Combiné" IsChecked="True" GroupName="PdfMode" Margin="4,4,12,4"/>
                                    <RadioButton x:Name="PdfSeparateRadio" Content="Séparé" GroupName="PdfMode" Margin="4,4,4,4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <CheckBox x:Name="DwgCheckBox" Content="DWG" IsChecked="True" Margin="4,4,18,4"/>
                                    <RadioButton x:Name="DwgCombinedRadio" Content="Combiné" GroupName="DwgMode" Margin="4,4,12,4"/>
                                    <RadioButton x:Name="DwgSeparateRadio" Content="Séparé" IsChecked="True" GroupName="DwgMode" Margin="4,4,4,4"/>
                                </StackPanel>
                                <TextBlock Text="Configuration DWG Revit" FontWeight="Bold" Margin="0,8,0,5"/>
                                <ComboBox x:Name="DwgSetupCombo" Height="30"/>
                                <CheckBox x:Name="DwgTrueColorCheckBox" Content="Couleur vraie" IsChecked="True" Margin="4,6,4,2"/>
                                <Button x:Name="PublishButton" Content="Publier les carnets sélectionnés" Click="Publish_Click" MinHeight="38" Margin="4,10,4,2"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Aperçu" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Carnet / valeur" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Feuilles" Binding="{Binding Count}" Width="90"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" x:Name="MissingInfo" TextWrapping="Wrap" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CreateButton" Content="Créer / mettre à jour" Click="Create_Click" MinWidth="170"/>
            <Button Content="Fermer" Click="Close_Click" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>