<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Export — Outils TAA" Height="850" Width="1220" MinHeight="700" MinWidth="1060" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource TaaBackground}" Foreground="{DynamicResource TaaText}" UseLayoutRounding="True">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource TaaBrand}" Margin="0,0,12,0" DockPanel.Dock="Left">
        <TextBlock Text="TAA" Foreground="{DynamicResource TaaSurface}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Export" FontSize="20" FontWeight="SemiBold" Margin="0" />
        <TextBlock Text="Publication PDF et DWG · Outils TAA" Foreground="{DynamicResource TaaSecondary}" FontSize="12" Margin="0,3,0,0" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="{DynamicResource TaaBorder}" BorderThickness="1" Padding="10" Margin="0,0,8,0" Style="{DynamicResource TaaCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Arborescence de publication" FontSize="16" FontWeight="Bold" />
              <TextBlock Text="Sélectionnez un dossier, un carnet ou une mise en page." Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
              <Button Content="Nouveau dossier" Click="NewFolder_Click" MinWidth="110" Margin="4,0" ToolTip="Nouveau dossier" />
              <Button Content="Ajouter / gérer…" Click="OpenCarnetManager_Click" MinWidth="130" Margin="4,0" ToolTip="Ajouter / gérer…" />
            </StackPanel>
          </StackPanel>
          <TreeView x:Name="PublicationTree" Grid.Row="1" AllowDrop="True" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Supprimer" Click="DeleteNode_Click" MinWidth="90" ToolTip="Supprimer" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" BorderBrush="{DynamicResource TaaBorder}" BorderThickness="1" Padding="12" Margin="8,0,0,0" Style="{DynamicResource TaaCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Réglages de publication" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel">
              <TextBlock x:Name="SelectedNodeText" Text="Sélectionnez un dossier, un carnet ou une mise en page dans l'arborescence." TextWrapping="Wrap" Margin="0,0,0,12" />
              <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Profil :" VerticalAlignment="Center" />
                <ComboBox x:Name="ProfileCombo" Width="180" Margin="8,0,0,0" SelectionChanged="ProfileChanged" />
                <Button Content="Enregistrer…" Click="SaveProfile_Click" Width="95" Margin="6,0,0,0" ToolTip="Enregistrer…" />
                <Button Content="Supprimer" Click="DeleteProfile_Click" Width="80" Margin="6,0,0,0" ToolTip="Supprimer" />
              </WrapPanel>
              <TextBlock x:Name="ProfileInfoText" Text="Les profils mémorisent les réglages PDF/DWG." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TaaSecondary}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Dossier :" VerticalAlignment="Center" />
                <ComboBox x:Name="FolderCombo" DisplayMemberPath="name" Width="210" Margin="8,0,0,0" SelectionChanged="FolderChanged" />
              </StackPanel>
              <Border BorderBrush="{DynamicResource TaaBorder}" BorderThickness="1" Padding="7" Margin="0,0,0,8" Style="{DynamicResource TaaCard}">
                <StackPanel>
                  <TextBlock x:Name="InheritanceInfoText" Text="" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TaaSecondary}" />
                  <Button x:Name="RevertInheritanceButton" Content="Revenir à l’héritage du dossier" Click="RevertInheritance_Click" MinWidth="190" IsEnabled="False" Margin="0,8,0,0" ToolTip="Revenir à l’héritage du dossier" HorizontalAlignment="Right" />
                </StackPanel>
              </Border>
              <GroupBox Header="PDF" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                  <CheckBox x:Name="PdfCheckBox" Content="Publier en PDF" Checked="SettingsChanged" Unchecked="SettingsChanged" />
                  <StackPanel Orientation="Horizontal" Margin="18,8,0,0">
                    <RadioButton x:Name="PdfCombinedRadio" Content="Combiné" GroupName="PdfMode" IsChecked="True" Checked="SettingsChanged" />
                    <RadioButton x:Name="PdfSeparateRadio" Content="Séparé" GroupName="PdfMode" Margin="15,0,0,0" Checked="SettingsChanged" />
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="DWG" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                  <CheckBox x:Name="DwgCheckBox" Content="Publier en DWG" Checked="SettingsChanged" Unchecked="SettingsChanged" />
                  <StackPanel Orientation="Horizontal" Margin="18,8,0,0">
                    <RadioButton x:Name="DwgCombinedRadio" Content="Combiné" GroupName="DwgMode" Checked="SettingsChanged" />
                    <RadioButton x:Name="DwgSeparateRadio" Content="Séparé" GroupName="DwgMode" IsChecked="True" Margin="15,0,0,0" Checked="SettingsChanged" />
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal" Margin="18,8,0,0">
                    <TextBlock Text="Configuration :" VerticalAlignment="Center" />
                    <ComboBox x:Name="DwgSetupCombo" Width="180" Margin="8,0,0,0" SelectionChanged="SettingsChanged" />
                    <CheckBox x:Name="DwgTrueColorCheckBox" Content="Couleur vraie" IsChecked="True" Margin="12,0,0,0" Checked="SettingsChanged" Unchecked="SettingsChanged" />
                  </WrapPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Destination et nommage" Padding="8">
                <StackPanel>
                  <TextBlock Text="Dossier de publication" />
                  <DockPanel Margin="0,5,0,8">
                    <Button Content="Parcourir…" Click="BrowseOutput_Click" Width="85" Margin="6,0,0,0" ToolTip="Parcourir…" DockPanel.Dock="Right" />
                    <TextBox x:Name="OutputDirectoryTextBox" HorizontalAlignment="Stretch" />
                  </DockPanel>
                  <TextBlock Text="Modèle de nommage" />
                  <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="FilenameTemplateTextBox" TextChanged="SettingsChanged" />
                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                      <Button Content="Insérer" Click="InsertFilenameToken_Click" Width="70" Margin="6,0,0,0" ToolTip="Insérer" DockPanel.Dock="Right" />
                      <ComboBox x:Name="FilenameTokenCombo" Margin="0" SelectionChanged="FilenameTokenChanged" />
                    </DockPanel>
                  </Grid>
                  <TextBlock Text="Variables : {carnet}, {numero}, {nom}, {nom_complet}, {projet}, {date}, {indice}, {dossier}, {parametre:Nom}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TaaSecondary}" />
                  <TextBlock Text="Aperçu du nom" Margin="0,8,0,0" />
                  <TextBlock x:Name="FilenamePreviewText" Text="—" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
          <TextBlock Grid.Row="2" x:Name="SelectionInfo" Text="Sélectionnez un dossier, un carnet ou une mise en page." TextWrapping="Wrap" Margin="0,10,0,0" />
        </Grid>
      </Border>
    </Grid>
    <GroupBox Grid.Row="2" Header="Publication" Padding="8" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="La sélection dans l'arborescence détermine le périmètre publié." VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="PublishButton" Content="Publier…" Click="Publish_Click" MinHeight="40" MinWidth="230" IsEnabled="False" Style="{DynamicResource TaaPrimaryButton}" ToolTip="Publier…" />
      </Grid>
    </GroupBox>
  </Grid>
</Window>
