<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Export" Height="780" Width="1220" MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Export" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Nouveau dossier" Click="NewFolder_Click" MinWidth="110" Margin="4,0"/><Button Content="Ajouter / gérer…" Click="OpenCarnetManager_Click" MinWidth="130" Margin="4,0"/></StackPanel><StackPanel><TextBlock Text="Arborescence de publication" FontSize="16" FontWeight="Bold"/><TextBlock Text="Dossier → carnet → mises en page. Les réglages du carnet sont mémorisés." Margin="0,3,0,0"/></StackPanel></DockPanel>
<TreeView x:Name="PublicationTree" Grid.Row="1" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Tout sélectionner" Click="SelectAllCarnets_Click" MinWidth="125" Margin="0,0,4,0"/><Button Content="Tout désélectionner" Click="UnselectAllCarnets_Click" MinWidth="135" Margin="0,0,4,0"/><Button Content="Supprimer" Click="DeleteNode_Click" MinWidth="90"/></StackPanel></Grid></Border>
<Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" Margin="8,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Réglages du carnet" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel">
<TextBlock x:Name="SelectedNodeText" Text="Sélectionnez un carnet dans l'arborescence." TextWrapping="Wrap" Margin="0,0,0,12"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Dossier :" VerticalAlignment="Center"/><ComboBox x:Name="FolderCombo" Width="210" Margin="8,0,0,0" SelectionChanged="FolderChanged"/></StackPanel>
<GroupBox Header="PDF" Padding="8" Margin="0,0,0,8"><StackPanel><CheckBox x:Name="PdfCheckBox" Content="Publier en PDF" Checked="SettingsChanged" Unchecked="SettingsChanged"/><StackPanel Orientation="Horizontal" Margin="18,8,0,0"><RadioButton x:Name="PdfCombinedRadio" Content="Combiné" GroupName="PdfMode" IsChecked="True" Checked="SettingsChanged"/><RadioButton x:Name="PdfSeparateRadio" Content="Séparé" GroupName="PdfMode" Margin="15,0,0,0" Checked="SettingsChanged"/></StackPanel></StackPanel></GroupBox>
<GroupBox Header="DWG" Padding="8" Margin="0,0,0,8"><StackPanel><CheckBox x:Name="DwgCheckBox" Content="Publier en DWG" Checked="SettingsChanged" Unchecked="SettingsChanged"/><StackPanel Orientation="Horizontal" Margin="18,8,0,0"><RadioButton x:Name="DwgCombinedRadio" Content="Combiné" GroupName="DwgMode" Checked="SettingsChanged"/><RadioButton x:Name="DwgSeparateRadio" Content="Séparé" GroupName="DwgMode" IsChecked="True" Margin="15,0,0,0" Checked="SettingsChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="18,8,0,0"><TextBlock Text="Configuration :" VerticalAlignment="Center"/><ComboBox x:Name="DwgSetupCombo" Width="180" Margin="8,0,0,0" SelectionChanged="SettingsChanged"/><CheckBox x:Name="DwgTrueColorCheckBox" Content="Couleur vraie" IsChecked="True" Margin="12,0,0,0" Checked="SettingsChanged" Unchecked="SettingsChanged"/></StackPanel></StackPanel></GroupBox>
<GroupBox Header="Destination et nommage" Padding="8"><StackPanel><TextBlock Text="Dossier de publication"/><StackPanel Orientation="Horizontal" Margin="0,5,0,8"><TextBox x:Name="OutputDirectoryTextBox" Height="28" HorizontalAlignment="Stretch" Width="250"/><Button Content="Parcourir…" Click="BrowseOutput_Click" Width="85" Margin="6,0,0,0"/></StackPanel><TextBlock Text="Nom de fichier (utilise {carnet})"/><TextBox x:Name="FilenameTemplateTextBox" Height="28" Margin="0,5,0,0" TextChanged="SettingsChanged"/></StackPanel></GroupBox>
</StackPanel></ScrollViewer>
<TextBlock Grid.Row="2" x:Name="SelectionInfo" Text="Cochez les carnets à publier." TextWrapping="Wrap" Margin="0,10,0,0"/>
</Grid></Border></Grid>
<GroupBox Grid.Row="2" Header="Publication" Padding="8" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Les réglages PDF / DWG sont enregistrés avec chaque carnet." VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="PublishButton" Content="Publier les carnets sélectionnés" Click="Publish_Click" MinHeight="38" MinWidth="230"/></Grid></GroupBox>
</Grid></Window>