<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Export" Height="760" Width="1180" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Export" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Carnets disponibles à la sélection" FontSize="16" FontWeight="Bold"/><TextBlock Text="Seuls les carnets contenant des feuilles du projet actuellement ouvert sont affichés." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Ajouter / gérer les carnets…" Click="OpenCarnetManager_Click" MinWidth="210"/></Grid>
<DataGrid Grid.Row="1" x:Name="PersistentCarnetsList" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" MinHeight="300" MouseDoubleClick="Carnet_MouseDoubleClick" MouseLeftButtonUp="CarnetCheckChanged">
<DataGrid.Columns><DataGridCheckBoxColumn Header="Publier" Binding="{Binding IsSelected, Mode=TwoWay}" Width="65"/><DataGridTextColumn Header="Carnet" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Feuilles" Binding="{Binding Count}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="État" Binding="{Binding Status}" Width="115" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,2"><Button Content="Tout sélectionner" Click="SelectAllCarnets_Click" MinWidth="135"/><Button Content="Tout désélectionner" Click="UnselectAllCarnets_Click" MinWidth="145"/><Button Content="Consulter les mises en pages" Click="ConsultCarnet_Click" MinWidth="190"/><Button Content="Supprimer" Click="DeleteCarnet_Click" MinWidth="90"/></StackPanel>
<TextBlock Grid.Row="3" x:Name="CarnetsSelectionInfo" Text="Cochez les carnets à publier." TextWrapping="Wrap" Margin="4,6,4,2"/></Grid></Border>
<Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" Margin="8,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Aperçu" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid Grid.Row="1" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,8"><DataGrid.Columns><DataGridTextColumn Header="Carnet" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Feuilles" Binding="{Binding Count}" Width="80"/><DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="160"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" x:Name="MissingInfo" TextWrapping="Wrap" Visibility="Collapsed"/></Grid></Border></Grid>
<GroupBox Grid.Row="2" Header="Publication" Padding="8" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="PdfCheckBox" Content="PDF" IsChecked="True" Margin="4,4,12,4"/><RadioButton x:Name="PdfCombinedRadio" Content="Combiné" IsChecked="True" GroupName="PdfMode" Margin="4,4,10,4"/><RadioButton x:Name="PdfSeparateRadio" Content="Séparé" GroupName="PdfMode" Margin="4,4,14,4"/><CheckBox x:Name="DwgCheckBox" Content="DWG" IsChecked="True" Margin="4,4,12,4"/><RadioButton x:Name="DwgCombinedRadio" Content="Combiné" GroupName="DwgMode" Margin="4,4,10,4"/><RadioButton x:Name="DwgSeparateRadio" Content="Séparé" IsChecked="True" GroupName="DwgMode" Margin="4,4,10,4"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Stretch"><TextBlock Text="Dossier :" FontWeight="Bold" Margin="4,4,6,4"/><TextBox x:Name="OutputDirectoryTextBox" Height="30" MinWidth="220" HorizontalAlignment="Stretch"/><Button Content="Parcourir…" Click="BrowseOutput_Click" Width="90"/><TextBlock Text="Configuration DWG :" FontWeight="Bold" Margin="10,4,6,4"/><ComboBox x:Name="DwgSetupCombo" Height="30" Width="145"/><CheckBox x:Name="DwgTrueColorCheckBox" Content="Couleur vraie" IsChecked="True" Margin="8,4,4,4"/></StackPanel><Button Grid.Column="2" x:Name="PublishButton" Content="Publier les carnets sélectionnés" Click="Publish_Click" MinHeight="38" MinWidth="220"/></Grid></GroupBox></Grid></Window>