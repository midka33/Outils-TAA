<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Charte commune : accent pastel, fonds neutres et texte sombre. -->
  <SolidColorBrush x:Key="TaaAccent" Color="#FD8B5A"/>
  <SolidColorBrush x:Key="TaaAccentHover" Color="#F77A45"/>
  <SolidColorBrush x:Key="TaaAccentPressed" Color="#E96B37"/>
  <SolidColorBrush x:Key="TaaBrand" Color="#FA641F"/>
  <SolidColorBrush x:Key="TaaBackground" Color="#F7F7F7"/>
  <SolidColorBrush x:Key="TaaSurface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TaaMuted" Color="#EFEFEF"/>
  <SolidColorBrush x:Key="TaaBorder" Color="#D9D9D9"/>
  <SolidColorBrush x:Key="TaaText" Color="#252525"/>
  <SolidColorBrush x:Key="TaaSecondary" Color="#666666"/>
  <SolidColorBrush x:Key="TaaDisabled" Color="#A0A0A0"/>
  <SolidColorBrush x:Key="TaaSelection" Color="#FFF0E8"/>
  <SolidColorBrush x:Key="TaaError" Color="#B42318"/>
  <SolidColorBrush x:Key="TaaWarning" Color="#8A5200"/>
  <SolidColorBrush x:Key="TaaSuccess" Color="#236B45"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFF0E8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#252525"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFF0E8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#252525"/>
  <Geometry x:Key="TaaFolderIcon">M1,4 L7,4 9,6 19,6 19,17 1,17 Z</Geometry>
  <Geometry x:Key="TaaBookIcon">M10,4 C7,2 3,2 1,3 L1,17 C4,16 7,16 10,18 C13,16 16,16 19,17 L19,3 C16,2 13,2 10,4 Z M10,4 L10,18</Geometry>
  <Geometry x:Key="TaaSheetIcon">M4,1 L12,1 17,6 17,19 4,19 Z M12,1 L12,6 17,6 M7,10 L14,10 M7,14 L14,14</Geometry>
  <Style x:Key="TaaCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource TaaSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TaaBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource TaaSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource TaaText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TaaBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TaaAccent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TaaText}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{StaticResource TaaMuted}"/><Setter Property="Foreground" Value="{StaticResource TaaDisabled}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TaaPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource TaaAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TaaAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource TaaAccentHover}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource TaaAccentPressed}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource TaaSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource TaaText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TaaBorder}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource TaaAccent}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TaaText}"/>
    <Setter Property="Background" Value="{StaticResource TaaSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TaaBorder}"/>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="BorderBrush" Value="{StaticResource TaaBorder}"/>
    <Setter Property="Background" Value="{StaticResource TaaSurface}"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox">
      <StackPanel><Border Background="{StaticResource TaaBackground}" Padding="8,6"><ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"/></Border>
      <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border></StackPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{StaticResource TaaSurface}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,8"/>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="Padding" Value="5,5"/><Setter Property="Foreground" Value="{StaticResource TaaText}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource TaaSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TaaBorder}"/>
    <Setter Property="RowBackground" Value="{StaticResource TaaSurface}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource TaaBackground}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TaaBorder}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="MinRowHeight" Value="32"/><Setter Property="ColumnHeaderHeight" Value="36"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource TaaMuted}"/><Setter Property="Foreground" Value="{StaticResource TaaSecondary}"/>
    <Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource TaaBorder}"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource TaaSelection}"/><Setter Property="Foreground" Value="{StaticResource TaaText}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal">
        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource TaaSecondary}" Background="{StaticResource TaaSurface}" VerticalAlignment="Center">
          <TextBlock x:Name="Mark" Text="✓" FontSize="12" Foreground="{StaticResource TaaText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Border>
        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource TaaAccent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Mark" Property="Text" Value="−"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Margin" Value="0,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <StackPanel Orientation="Horizontal">
        <Grid Width="16" Height="16" VerticalAlignment="Center">
          <Ellipse x:Name="Ring" Stroke="{StaticResource TaaSecondary}" Fill="{StaticResource TaaSurface}" StrokeThickness="1"/>
          <Ellipse x:Name="Dot" Fill="{StaticResource TaaAccentPressed}" Margin="4" Visibility="Collapsed"/>
        </Grid>
        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="StrokeThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
