<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TAABrandOrangeBrush" Color="#FA641F"/>
    <SolidColorBrush x:Key="TAAOrangeBrush" Color="#FD8B5A"/>
    <SolidColorBrush x:Key="TAAOrangeHoverBrush" Color="#F77A45"/>
    <SolidColorBrush x:Key="TAAOrangePressedBrush" Color="#E96B37"/>
    <SolidColorBrush x:Key="TAABackgroundBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="TAAPanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TAABorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="TAATextBrush" Color="#252525"/>
    <SolidColorBrush x:Key="TAASecondaryTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TAADisabledBrush" Color="#D8D8D8"/>

    <Style x:Key="TAAPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource TAAOrangeBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TAAOrangeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TAAOrangeHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TAAOrangeHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource TAAOrangePressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource TAADisabledBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TAADisabledBrush}"/>
                <Setter Property="Foreground" Value="#8A8A8A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TAASecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource TAATextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TAABorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style x:Key="TAASectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TAATextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="TAASecondaryText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TAASecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TAAComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="TAATextBox" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TAABorderBrush}"/>
    </Style>
</ResourceDictionary>
